<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Maziwa Printer PRO - Deriv Auto Trader</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@600;800;900&display=swap'); body{font-family:Inter,sans-serif}</style>
</head>
<body class="bg-[#020d08] flex justify-center">
<div class="w-full max-w-[430px] bg-[#0a0a0a] min-h-screen border-x border-[#1f1f1f]">

<div class="p-5 flex justify-between items-center">
<div class="flex gap-2 items-center">
<div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-lg">🥛</div>
<div><h1 class="font-black text-white leading-none">Maziwa Printer <span class="text-emerald-400">PRO</span></h1><p class="text-[10px] text-gray-400 mt-1">Deriv Auto Trader • AI Scanner Live</p></div>
</div>
<span class="text-[9px] bg-emerald-900/40 border border-emerald-800 text-emerald-400 px-2 py-1 rounded-full font-bold">PRO</span>
</div>

<div class="mx-4 p-4 rounded-[20px] bg-gradient-to-br from-[#123524] to-[#0a1a1a] border border-emerald-900/40 shadow-[0_0_25px_rgba(16,185,129,0.18)]">
<div class="flex justify-between items-start"><div><p class="text-[11px] text-gray-400">AI Scanner Status</p><p class="font-bold text-white text-sm mt-0.5">Scanning Markets • Active</p></div><span class="bg-emerald-500 text-black px-3 py-1 rounded-full text-[10px] font-black">ONLINE</span></div>
<div class="grid grid-cols-3 mt-4 pt-3 border-t border-white/5">
<div><p class="text-[10px] text-gray-400">Today's P&L</p><p id="pnl" class="text-emerald-400 font-black text-[16px]">+$0.00</p></div>
<div><p class="text-[10px] text-gray-400">Win Rate</p><p class="font-black text-white">84%</p></div>
<div><p class="text-[10px] text-gray-400">Trades</p><p id="tr" class="font-black text-white">0</p></div>
</div>
</div>

<div class="m-4 bg-[#141414] border border-[#222] rounded-[16px] p-3">
<div class="flex justify-between items-center"><p class="font-bold text-xs text-white">🎯 AI Scanner Live</p><span id="conf" class="text-[10px] bg-[#1f1f1f] px-2 py-1 rounded-full text-white border border-[#333]">Confidence 92%</span></div>
<p id="log" class="text-[11px] text-emerald-400 mt-2 font-mono border-l-2 border-emerald-500 pl-2">Waiting for live ticks...</p>
<div class="mt-3 bg-black rounded-xl p-2 flex justify-between items-center"><span class="text-xs text-gray-400">TICK</span><span id="tick" class="text-sm font-bold text-emerald-400">-</span></div>
<div id="grid" class="grid grid-cols-5 gap-2 mt-3"></div>
<div class="grid grid-cols-2 gap-2 mt-3"><div class="bg-[#0e0e0e] border border-[#222] rounded-xl p-2 text-center"><p class="text-[10px] text-gray-400">EVEN</p><p id="evenPct" class="text-emerald-400 font-bold">0%</p></div><div class="bg-[#0e0e0e] border border-[#222] rounded-xl p-2 text-center"><p class="text-[10px] text-gray-400">ODD</p><p id="oddPct" class="text-red-400 font-bold">0%</p></div></div>
</div>

<div class="m-4 bg-[#101010] border border-[#1f1f1f] rounded-[16px] p-4">
<input id="token" placeholder="Deriv API Token - paste here" class="w-full bg-black border border-[#222] rounded-xl p-3 text-xs text-white mb-3 outline-none">
<div class="grid grid-cols-2 gap-3 mb-3">
<select id="market" class="bg-black border border-[#222] rounded-xl p-3 text-xs text-white"><option value="R_100">Volatility 100</option><option value="R_10">Volatility 10</option><option value="1HZ100V">Vol 100 (1s)</option><option value="1HZ10V">Vol 10 (1s)</option></select>
<input id="stake" value="0.50" type="number" step="0.1" class="bg-black border border-[#222] rounded-xl p-3 text-xs text-white">
</div>
<select id="type" class="w-full bg-black border border-[#222] rounded-xl p-3 text-xs text-white mb-3"><option value="DIGITEVEN">Even</option><option value="DIGITODD">Odd</option><option value="CALL">Rise</option><option value="PUT">Fall</option><option value="DIGITOVER">Over</option><option value="DIGITUNDER">Under</option></select>
<button onclick="startBot()" class="w-full bg-gradient-to-r from-emerald-400 to-emerald-600 text-black font-black py-4 rounded-full shadow-[0_0_25px_rgba(16,185,129,0.5)]">▶ START PRINTING</button>
<button onclick="stopBot()" class="w-full bg-[#1a1a1a] border border-[#333] text-white font-bold py-3 rounded-full mt-3 text-sm">■ STOP</button>
<p class="text-[9px] text-gray-500 text-center mt-3">Risk: Trading involves risk. For educational use only.</p>
</div>

</div>
<script>
let ws, counts=Array(10).fill(0), total=0, running=false;
function connect(){
 ws=new WebSocket('wss://ws.derivws.com/websockets/v3?app_id=1089');
 ws.onopen=()=>{ws.send(JSON.stringify({ticks_history:document.getElementById('market').value,count:500,end:'latest',style:'ticks'}));ws.send(JSON.stringify({ticks:document.getElementById('market').value,subscribe:1}));}
 ws.onmessage=(e)=>{let d=JSON.parse(e.data); if(d.tick){let q=d.tick.quote; document.getElementById('tick').innerText=q; let dg=parseInt(q.toString().slice(-1)); if(!isNaN(dg)){counts[dg]++; total++; draw();}}}
}
function draw(){
 let g=document.getElementById('grid'); g.innerHTML=''; let even=0,odd=0;
 counts.forEach((v,i)=>{let p=total?((v/total*100).toFixed(1)):0; if(i%2==0)even+=parseFloat(p); else odd+=parseFloat(p); g.innerHTML+=`<div class="bg-black border border-[#222] rounded-lg p-2 text-center"><p class="text-white font-bold text-sm">${i}</p><p class="text-cyan-400 text-[10px]">${p}%</p></div>`});
 document.getElementById('evenPct').innerText=even.toFixed(1)+'%'; document.getElementById('oddPct').innerText=odd.toFixed(1)+'%';
}
connect();
document.getElementById('market').addEventListener('change',()=>{ws.close(); counts=Array(10).fill(0); total=0; connect();});
function startBot(){let t=document.getElementById('token').value; if(!t)return alert('Paste Deriv API Token first!'); document.getElementById('log').innerText='🟢 STARTED - Trading '+document.getElementById('type').value+' on '+document.getElementById('market').value; running=true;}
function stopBot(){document.getElementById('log').innerText='🔴 STOPPED'; running=false;}
</script>
</body>
</html>
